# 장인몰 PR 정책 — gen-pr.sh 가 읽는 정책 파일
# 형식: source 될 수 있는 shell 변수 할당

BASE_BRANCH="origin/develop"
PR_OUT=".context/pr-summary.md"

COMPILE_CMD="./gradlew -q compileJava"
TEST_CMD="./gradlew -q test"

MAX_FILES="25"
CONTROLLER_TEST_CHECK="true"

# PR 산출물에서 제외할 AI/Harness 관련 파일
EXCLUDES=(
  "CLAUDE.md"
  "AGENTS.md"
  "GEMINI.md"
  ".context"
  ".context/**"
  ".conductor"
  ".conductor/**"
  "opencode.json"
)