{
  "title": "Backend Overview — product / content / notification",
  "uid": "backend-overview",
  "tags": ["backend", "jangingmall"],
  "timezone": "Asia/Seoul",
  "schemaVersion": 38,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "job",
        "type": "custom",
        "label": "환경",
        "query": "backend-local,backend-prod",
        "current": { "text": "backend-local", "value": "backend-local" },
        "options": [
          { "text": "backend-local", "value": "backend-local", "selected": true },
          { "text": "backend-prod",  "value": "backend-prod",  "selected": false }
        ],
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "HTTP 요청률 — 도메인별 (req/s)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum by (uri) (rate(http_server_requests_seconds_count{job=\"$job\", uri=~\"/api/products.*\"}[1m]))",
          "legendFormat": "product — {{uri}}"
        },
        {
          "expr": "sum by (uri) (rate(http_server_requests_seconds_count{job=\"$job\", uri=~\"/api/contents.*|/api/interviews.*|/api/generations.*\"}[1m]))",
          "legendFormat": "content — {{uri}}"
        },
        {
          "expr": "sum by (uri) (rate(http_server_requests_seconds_count{job=\"$job\", uri=~\"/api/notifications.*\"}[1m]))",
          "legendFormat": "notification — {{uri}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps" }
      }
    },
    {
      "id": 2,
      "title": "HTTP 평균 응답 지연 — 도메인별 (ms)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_sum{job=\"$job\", uri=~\"/api/products.*\"}[2m])) / sum(rate(http_server_requests_seconds_count{job=\"$job\", uri=~\"/api/products.*\"}[2m])) * 1000",
          "legendFormat": "product"
        },
        {
          "expr": "sum(rate(http_server_requests_seconds_sum{job=\"$job\", uri=~\"/api/contents.*|/api/interviews.*|/api/generations.*\"}[2m])) / sum(rate(http_server_requests_seconds_count{job=\"$job\", uri=~\"/api/contents.*|/api/interviews.*|/api/generations.*\"}[2m])) * 1000",
          "legendFormat": "content"
        },
        {
          "expr": "sum(rate(http_server_requests_seconds_sum{job=\"$job\", uri=~\"/api/notifications.*\"}[2m])) / sum(rate(http_server_requests_seconds_count{job=\"$job\", uri=~\"/api/notifications.*\"}[2m])) * 1000",
          "legendFormat": "notification"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ms" }
      }
    },
    {
      "id": 3,
      "title": "HTTP 5xx 에러율 — 도메인별 (req/s)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"$job\", uri=~\"/api/products.*\", status=~\"5..\"}[1m]))",
          "legendFormat": "product 5xx"
        },
        {
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"$job\", uri=~\"/api/contents.*|/api/interviews.*|/api/generations.*\", status=~\"5..\"}[1m]))",
          "legendFormat": "content 5xx"
        },
        {
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"$job\", uri=~\"/api/notifications.*\", status=~\"5..\"}[1m]))",
          "legendFormat": "notification 5xx"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "color": { "fixedColor": "red", "mode": "fixed" } }
      }
    },
    {
      "id": 4,
      "title": "HTTP P95 응답 지연 — 도메인별 (ms)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"$job\", uri=~\"/api/products.*\"}[2m]))) * 1000",
          "legendFormat": "product p95"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"$job\", uri=~\"/api/contents.*|/api/interviews.*|/api/generations.*\"}[2m]))) * 1000",
          "legendFormat": "content p95"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"$job\", uri=~\"/api/notifications.*\"}[2m]))) * 1000",
          "legendFormat": "notification p95"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ms" }
      }
    },
    {
      "id": 10,
      "title": "SSE 활성 연결 수",
      "type": "stat",
      "gridPos": { "x": 0, "y": 16, "w": 4, "h": 4 },
      "targets": [
        {
          "expr": "sse_active_connections{job=\"$job\"}",
          "legendFormat": "active"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "thresholds" },
          "thresholds": { "steps": [
            { "color": "green", "value": 0 },
            { "color": "yellow", "value": 100 },
            { "color": "red", "value": 500 }
          ]}
        }
      }
    },
    {
      "id": 11,
      "title": "SSE 전송 성공 속도 (per min)",
      "type": "stat",
      "gridPos": { "x": 4, "y": 16, "w": 4, "h": 4 },
      "targets": [
        {
          "expr": "rate(sse_sent_total{job=\"$job\"}[1m]) * 60",
          "legendFormat": "sent/min"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" }
      }
    },
    {
      "id": 12,
      "title": "SSE 전송 실패 속도 (per min)",
      "type": "stat",
      "gridPos": { "x": 8, "y": 16, "w": 4, "h": 4 },
      "targets": [
        {
          "expr": "rate(sse_failed_total{job=\"$job\"}[1m]) * 60",
          "legendFormat": "failed/min"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "fixedColor": "red", "mode": "fixed" } }
      }
    },
    {
      "id": 13,
      "title": "SSE 연결 수 추이",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sse_active_connections{job=\"$job\"}",
          "legendFormat": "active connections"
        },
        {
          "expr": "rate(sse_sent_total{job=\"$job\"}[1m]) * 60",
          "legendFormat": "sent/min"
        },
        {
          "expr": "rate(sse_failed_total{job=\"$job\"}[1m]) * 60",
          "legendFormat": "failed/min"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" }
      }
    },
    {
      "id": 20,
      "title": "HikariCP 커넥션 풀",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 24, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "hikaricp_connections_active{job=\"$job\"}",
          "legendFormat": "active"
        },
        {
          "expr": "hikaricp_connections_idle{job=\"$job\"}",
          "legendFormat": "idle"
        },
        {
          "expr": "hikaricp_connections_pending{job=\"$job\"}",
          "legendFormat": "pending"
        },
        {
          "expr": "hikaricp_connections_max{job=\"$job\"}",
          "legendFormat": "max"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" }
      }
    },
    {
      "id": 21,
      "title": "Tomcat Thread Pool",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 24, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "tomcat_threads_busy_threads{job=\"$job\"}",
          "legendFormat": "busy"
        },
        {
          "expr": "tomcat_threads_current_threads{job=\"$job\"}",
          "legendFormat": "current"
        },
        {
          "expr": "tomcat_threads_config_max_threads{job=\"$job\"}",
          "legendFormat": "max"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" }
      }
    },
    {
      "id": 30,
      "title": "JVM Heap 사용률 (%)",
      "type": "gauge",
      "gridPos": { "x": 0, "y": 32, "w": 6, "h": 6 },
      "targets": [
        {
          "expr": "sum(jvm_memory_used_bytes{job=\"$job\", area=\"heap\"}) / sum(jvm_memory_max_bytes{job=\"$job\", area=\"heap\"}) * 100",
          "legendFormat": "heap %"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percent", "min": 0, "max": 100,
          "thresholds": { "steps": [
            { "color": "green", "value": 0 },
            { "color": "yellow", "value": 70 },
            { "color": "red", "value": 85 }
          ]}
        }
      }
    },
    {
      "id": 31,
      "title": "CPU 사용률 (%)",
      "type": "gauge",
      "gridPos": { "x": 6, "y": 32, "w": 6, "h": 6 },
      "targets": [
        {
          "expr": "process_cpu_usage{job=\"$job\"} * 100",
          "legendFormat": "cpu %"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percent", "min": 0, "max": 100,
          "thresholds": { "steps": [
            { "color": "green", "value": 0 },
            { "color": "yellow", "value": 60 },
            { "color": "red", "value": 80 }
          ]}
        }
      }
    },
    {
      "id": 32,
      "title": "GC Pause 최대값 (ms)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 32, "w": 12, "h": 6 },
      "targets": [
        {
          "expr": "jvm_gc_pause_seconds_max{job=\"$job\"} * 1000",
          "legendFormat": "{{action}} {{cause}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ms" }
      }
    },
    {
      "id": 40,
      "title": "product — API별 요청률 (req/s)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 38, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "rate(http_server_requests_seconds_count{job=\"$job\", uri=~\"/api/products.*\"}[1m])",
          "legendFormat": "{{method}} {{uri}} {{status}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "id": 41,
      "title": "product — API별 P95 지연 (ms)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 38, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, uri) (rate(http_server_requests_seconds_bucket{job=\"$job\", uri=~\"/api/products.*\"}[2m]))) * 1000",
          "legendFormat": "p95 {{uri}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" } }
    },
    {
      "id": 50,
      "title": "content — API별 요청률 (req/s)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 46, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "rate(http_server_requests_seconds_count{job=\"$job\", uri=~\"/api/contents.*|/api/interviews.*|/api/generations.*\"}[1m])",
          "legendFormat": "{{method}} {{uri}} {{status}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "id": 51,
      "title": "content — API별 P95 지연 (ms)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 46, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, uri) (rate(http_server_requests_seconds_bucket{job=\"$job\", uri=~\"/api/contents.*|/api/interviews.*|/api/generations.*\"}[2m]))) * 1000",
          "legendFormat": "p95 {{uri}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" } }
    },
    {
      "id": 60,
      "title": "notification — API별 요청률 (req/s)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 54, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "rate(http_server_requests_seconds_count{job=\"$job\", uri=~\"/api/notifications.*\"}[1m])",
          "legendFormat": "{{method}} {{uri}} {{status}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "id": 61,
      "title": "notification — API별 P95 지연 (ms)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 54, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, uri) (rate(http_server_requests_seconds_bucket{job=\"$job\", uri=~\"/api/notifications.*\"}[2m]))) * 1000",
          "legendFormat": "p95 {{uri}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" } }
    }
  ]
}
