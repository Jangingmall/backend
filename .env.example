# ── Spring ───────────────────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=prod

# ── Database (RDS PostgreSQL) ─────────────────────────────────────────────────
DB_URL=jdbc:postgresql://<RDS_ENDPOINT>:5432/jangingmall
DB_USERNAME=
DB_PASSWORD=

# ── Redis (ElastiCache) ───────────────────────────────────────────────────────
REDIS_HOST=<ELASTICACHE_ENDPOINT>
REDIS_PORT=6379

# ── JWT ───────────────────────────────────────────────────────────────────────
# HS256 최소 256-bit (32자 이상) 랜덤 문자열
JWT_SECRET=

# ── Mail (SES SMTP) ───────────────────────────────────────────────────────────
MAIL_HOST=email-smtp.ap-northeast-2.amazonaws.com
MAIL_PORT=587
MAIL_USERNAME=
# Google SMTP 앱 비밀번호(로그인 비밀번호 아님). 실제 값은 Secret/SSM으로 주입
MAIL_PASSWORD=PENDING_GOOGLE_APP_PASSWORD
MAIL_FROM=no-reply@midam.store

# ── S3 이미지 (로컬 실연동 시 필수 3개) ───────────────────────────────────────
# AWS SDK Default Credential Chain을 사용합니다. 먼저 `aws sso login --profile <프로파일명>`을 실행하세요.
# AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY/AWS_REGION은 로컬 .env에 넣지 않습니다.
IMAGE_BASE_URL=https://<버킷명>.s3.ap-northeast-2.amazonaws.com
IMAGE_UPLOAD_BUCKET=<업로드버킷명>
IMAGE_RETURN_BUCKET=<리턴버킷명>

# ── OAuth2 ────────────────────────────────────────────────────────────────────
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ── 이메일 인증 ───────────────────────────────────────────────────────────────
EMAIL_VERIFICATION_URL=https://midam.store/api/member/email-verifications/verify
EMAIL_VERIFICATION_SUCCESS_REDIRECT=https://midam.store/
EMAIL_VERIFICATION_TTL_SECONDS=1800

# ── OAuth 프론트엔드 콜백 ─────────────────────────────────────────────────────
OAUTH_FRONTEND_REDIRECT_URL=https://midam.store/oauth/callback
OAUTH_HTTP_TIMEOUT_MILLIS=5000

# ── Rate Limit ────────────────────────────────────────────────────────────────
MEMBER_RATE_LIMIT_ATTEMPTS=10
MEMBER_RATE_LIMIT_WINDOW_SECONDS=60

# ── AI 서버 ───────────────────────────────────────────────────────────────────
# SGLang: 챗봇 추천 (POST /ai/chat)
AI_SGLANG_URL=http://<SGLANG_SERVER_HOST>:8001
# Ollama: 콘텐츠 생성·상품 동기화 (POST /ai/products, /ai/products/sync, PUT, DELETE)
AI_OLLAMA_URL=http://<OLLAMA_SERVER_HOST>:8002

# =============================================================================
# GitHub Actions Secrets (repo Settings → Secrets → Actions에 등록)
# 아래 값들은 로컬 .env가 아니라 GitHub Secrets으로만 관리
# =============================================================================
#
# AWS_ACCESS_KEY_ID       — ECR push + SSM send-command 권한을 가진 IAM 계정
# AWS_SECRET_ACCESS_KEY   — 위 IAM 계정의 Secret Access Key
# EC2_INSTANCE_ID         — 배포 대상 EC2 인스턴스 ID (예: i-0abc1234567890def)
#
# IAM 권한 최소 범위:
#   ecr:GetAuthorizationToken
#   ecr:BatchCheckLayerAvailability
#   ecr:GetDownloadUrlForLayer
#   ecr:PutImage
#   ecr:InitiateLayerUpload
#   ecr:UploadLayerPart
#   ecr:CompleteLayerUpload
#   ssm:SendCommand
#   ssm:GetCommandInvocation
